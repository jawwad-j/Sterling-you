{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      "storage.rules",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "publicly/**",
      "services/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          }
        ]
      },
      {
        "source": "/sitemap.xml",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/xml"
          }
        ]
      }
    ],
    "cleanUrls": true,
    "trailingSlash": false,
"rewrites": [
{
  "source": "/p",
  "function": "productPreview",
  "region": "us-central1"
},
  {
    "source": "/__/auth/**",
    "destination": "/__/auth/handler"
  },
  {
    "source": "/home",
    "destination": "/index.html"
  },
  {
    "source": "/category",
    "destination": "/category.html"
  },
  {
    "source": "/product",
    "destination": "/product.html"
  },
  {
    "source": "/checkout",
    "destination": "/checkout.html"
  },
  {
    "source": "/account",
    "destination": "/account.html"
  },
  {
    "source": "/login",
    "destination": "/login.html"
  },
  {
    "source": "/terms",
    "destination": "/terms.html"
  }
]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}