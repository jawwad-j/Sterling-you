rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid));
    }
    match /products/{productId} {
      allow read: if true;
      allow update: if request.auth != null && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']);
      allow write: if isAdmin();
    }
    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /category_banners/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /support_links/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /social_links/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /logisticsRates/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /customerShippingRules/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /invoice_terms/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if isAdmin();
    }
    match /orders/{orderId} {
      allow read: if request.auth != null && 
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }
    match /preorders/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /contact_messages/{msgId} {
      allow create: if request.auth != null;
      allow read, write: if isAdmin();
    }
    match /customer_queries/{docId} {
      allow create: if request.auth != null;
      allow read, write: if isAdmin();
    }
    match /product_requests/{docId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }
    match /admin_users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }
    match /admin_activity_logs/{docId} {
      allow read, write: if isAdmin();
    }
    match /payout_batches/{docId} {
      allow read, write: if isAdmin();
    }
    match /phone_lookups/{phone} {
      allow read: if true;
      allow write: if true;
    }
    match /otp_rate_limits/{phone} {
      allow read, write: if true;
    }
    match /otp_daily_cap/{date} {
      allow read, write: if true;
    }
    match /site_analytics/{docId} {
      allow read: if isAdmin();
      allow write: if true;
    }
    match /site_visitors/{docId} {
      allow read: if isAdmin();
      allow write: if true;
    }
    match /newsletter_subscribers/{subscriber} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}